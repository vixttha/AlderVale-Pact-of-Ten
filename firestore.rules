rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRealm(realmId) {
      return realmId in ['breeze', 'horizon', 'everpeak'];
    }

    function isValidAccountProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'settings', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('settings' in data) || data.settings is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /accounts/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && uid == request.auth.uid
        && isValidAccountProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && uid == request.auth.uid
        && isValidAccountProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'settings', 'updatedAt']);

      match /realms/{realmId} {
        allow get: if isSignedIn() && isValidId(uid) && isValidId(realmId) && isValidRealm(realmId) && uid == request.auth.uid;
        // Earlier realm snapshots remain readable to their owner.
        allow write: if false;
      }
    }

    match /wizards/{wizardId} {
      allow get: if isSignedIn() && isValidId(wizardId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      // Gameplay documents are written through authenticated server actions.
      allow write: if false;

      match /creatures/{creatureId} {
        allow get: if isSignedIn() && isValidId(wizardId) && isValidId(creatureId)
          && get(/databases/$(database)/documents/wizards/$(wizardId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/wizards/$(wizardId)).data.ownerId == request.auth.uid;
        allow write: if false;
      }

      match /private/gallery {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/wizards/$(wizardId)).data.ownerId == request.auth.uid;
        allow create, update: if isVerifiedUser()
          && get(/databases/$(database)/documents/wizards/$(wizardId)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/wizards/$(wizardId)).data.serverProgressionVersion == 1
          && incoming().keys().hasOnly(['images'])
          && incoming().images is list && incoming().images.size() <= 9;
      }

      match /sanctuary/{docId} {
        allow get: if isSignedIn() && isValidId(wizardId) && isValidId(docId)
          && (get(/databases/$(database)/documents/wizards/$(wizardId)).data.ownerId == request.auth.uid
            || (existing().isPublic == true && exists(/databases/$(database)/documents/worldRealms/$(existing().realmId)/dormTours/$(wizardId))));
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }

    // Legacy read-only paths. Current clients use the server API for realm services.
    match /bazaar/{realmId}/listings/{listingId} {
      allow get: if isSignedIn() && isValidRealm(realmId) && isValidId(listingId);
      allow list: if isSignedIn() && resource.data.realmId == realmId;
    }

    match /houses/{realmId}/clubs/{houseId} {
      allow get: if isSignedIn() && isValidRealm(realmId) && isValidId(houseId);
      allow list: if isSignedIn() && resource.data.realmId == realmId;
    }

    // Wallets, listing escrow, Houses, duel receipts and tour indexes are server-only.
    match /worldRealms/{path=**} {
      allow read, write: if false;
    }

    match /publicWizards/{wizardId} {
      allow get: if isSignedIn() && isValidId(wizardId);
      allow list: if isSignedIn() && resource.data.realmId in ['breeze', 'horizon', 'everpeak'];
      allow write: if false;
    }
  }
}
