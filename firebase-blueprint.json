{
  "entities": {
    "AccountProfile": {
      "title": "AccountProfile",
      "description": "Private user account metadata isolated from public gameplay records.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "RealmAccount": {
      "title": "RealmAccount",
      "description": "Strictly isolated realm account holding wizard slots, unlocked races, shared realm vault, and free Term Reward Track.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "realmId": { "type": "string", "enum": ["breeze", "horizon", "everpeak"] },
        "wizardIds": { "type": "array" },
        "unlockedRaces": { "type": "array" },
        "sharedVault": { "type": "array" },
        "termXp": { "type": "number" },
        "claimedTermTiers": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "realmId", "wizardIds", "unlockedRaces", "termXp", "createdAt", "updatedAt"]
    },
    "Wizard": {
      "title": "Wizard",
      "description": "Player wizard profile with race, element affinity, wardrobe, deck, inventory, quests, and prestige progress.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "realmId": { "type": "string", "enum": ["breeze", "horizon", "everpeak"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 24 },
        "raceId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "beastClan": { "type": "string", "maxLength": 24 },
        "elementId": { "type": "string", "minLength": 2, "maxLength": 24 },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "rank": { "type": "number" },
        "sculpt": { "type": "object" },
        "wardrobe": { "type": "object" },
        "stitching": { "type": "object" },
        "currencies": { "type": "object" },
        "resources": { "type": "object" },
        "progression": { "type": "object" },
        "activeCreatureId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "realmId", "name", "raceId", "elementId", "level", "xp", "rank", "sculpt", "wardrobe", "currencies", "createdAt", "updatedAt"]
    },
    "Creature": {
      "title": "Creature",
      "description": "Bonded creature belonging to a wizard, with evolution stage, chromatic variant, branch skill, and talents.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "wizardId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "realmId": { "type": "string", "enum": ["breeze", "horizon", "everpeak"] },
        "speciesId": { "type": "string", "minLength": 2, "maxLength": 40 },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 24 },
        "elementId": { "type": "string", "minLength": 2, "maxLength": 24 },
        "stage": { "type": "number" },
        "chromatic": { "type": "string", "enum": ["none", "dawn", "dusk"] },
        "branchChoice": { "type": "string", "enum": ["A", "B"] },
        "bondXp": { "type": "number" },
        "wins": { "type": "number" },
        "talents": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "wizardId", "realmId", "speciesId", "nickname", "elementId", "stage", "chromatic", "bondXp", "wins", "createdAt", "updatedAt"]
    },
    "SanctuaryLayout": {
      "title": "SanctuaryLayout",
      "description": "3D Personal Dorm layout with theme, weather, interactive triggers, garden plots, and public tour status.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "wizardId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "realmId": { "type": "string", "enum": ["breeze", "horizon", "everpeak"] },
        "themeId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "weatherId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "isPublic": { "type": "boolean" },
        "ratingSum": { "type": "number" },
        "ratingCount": { "type": "number" },
        "items": { "type": "array" },
        "gardens": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "wizardId", "realmId", "themeId", "weatherId", "isPublic", "items", "createdAt", "updatedAt"]
    },
    "BazaarListing": {
      "title": "BazaarListing",
      "description": "Server-owned listing with Bazaar gear held in escrow while open.",
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "sellerUid": {"type": "string"},
        "sellerName": {"type": "string"},
        "itemId": {"type": "string"},
        "itemName": {"type": "string"},
        "priceFlorins": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "status": {"type": "string", "enum": ["open", "sold", "cancelled"]},
        "buyerUid": {"type": "string"}
      },
      "required": ["id", "sellerUid", "sellerName", "itemId", "itemName", "priceFlorins", "status"]
    },
    "AcademyHouse": {
      "title": "AcademyHouse",
      "description": "Server-owned House record. Public API returns member count without account IDs.",
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 32},
        "crestElement": {"type": "string"},
        "motto": {"type": "string", "maxLength": 120},
        "members": {"type": "array", "items": {"type": "string"}, "maxItems": 100}
      },
      "required": ["name", "crestElement", "motto", "members"]
    },
    "PublicWizardCard": {
      "title": "PublicWizardCard",
      "description": "Non-PII public inspector snapshot for click-to-inspect in the 3D hub.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "realmId": { "type": "string", "enum": ["breeze", "horizon", "everpeak"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 24 },
        "raceId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "elementId": { "type": "string", "minLength": 2, "maxLength": 24 },
        "level": { "type": "number" },
        "rank": { "type": "number" },
        "titleBadge": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "realmId", "name", "raceId", "elementId", "level", "rank", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/accounts/{uid}": {
      "schema": { "$ref": "#/entities/AccountProfile" },
      "description": "Private user account profile containing PII isolated by uid."
    },
    "/accounts/{uid}/realms/{realmId}": {
      "schema": { "$ref": "#/entities/RealmAccount" },
      "description": "Realm-isolated progression, unlocked races, and shared realm vault."
    },
    "/wizards/{wizardId}": {
      "schema": { "$ref": "#/entities/Wizard" },
      "description": "Wizard save document owned by ownerId inside a specific realmId."
    },
    "/wizards/{wizardId}/creatures/{creatureId}": {
      "schema": { "$ref": "#/entities/Creature" },
      "description": "Creatures bonded to a wizard."
    },
    "/wizards/{wizardId}/sanctuary/{docId}": {
      "schema": { "$ref": "#/entities/SanctuaryLayout" },
      "description": "Sanctuary Dorm layout, triggers, and garden plots."
    },
    "/worldRealms/{realmId}/listings/{listingId}": {
      "schema": { "$ref": "#/entities/BazaarListing" },
      "description": "Realm-isolated Courtyard Bazaar listings."
    },
    "/worldRealms/{realmId}/clubs/{houseId}": {
      "schema": { "$ref": "#/entities/AcademyHouse" },
      "description": "Realm-isolated Academy Houses."
    },
    "/worldRealms/{realmId}/houseMemberships/{uid}": {
      "schema": { "type": "object", "properties": { "houseId": { "type": "string" } }, "required": ["houseId"] },
      "description": "Server-owned, realm-scoped coordination record for one current House per account."
    },
    "/publicWizards/{wizardId}": {
      "schema": { "$ref": "#/entities/PublicWizardCard" },
      "description": "Public non-PII click-to-inspect wizard cards."
    }
  }
}
